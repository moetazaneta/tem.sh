---
import ThemePicker from "../components/theme-picker.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (() => {
        const systemMode = window.matchMedia("(prefers-color-scheme: dark)");
        const applyMode = (preference) => {
          document.documentElement.dataset.modePreference = preference;
          document.documentElement.dataset.mode =
            preference === "auto"
              ? systemMode.matches
                ? "dark"
                : "light"
              : preference;
          window.dispatchEvent(new CustomEvent("modechange"));
        };
        const restoreMode = () => {
          let preference = "auto";
          try {
            const saved = localStorage.getItem("mode");
            if (saved === "light" || saved === "dark") preference = saved;
          } catch {}
          applyMode(preference);
        };
        restoreMode();
        document.addEventListener("astro:after-swap", restoreMode);
        systemMode.addEventListener("change", () => {
          if (document.documentElement.dataset.modePreference === "auto")
            applyMode("auto");
        });
        window.addEventListener("storage", (event) => {
          if (event.key === "mode" || event.key === null) restoreMode();
        });
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="generator" content={Astro.generator} />
    <title>tem</title>
  </head>
  <body class="flex flex-col items-center bg-canvas text-content text-2xl/8.5 sm:text-xl font-louize">
    <main class="max-w-[42.5rem] w-full px-5 pt-10 pb-8 sm:pt-32 sm:pb-16 h-full flex flex-col gap-8">
      <slot />
      <div class="flex flex-col items-end gap-8 mt-auto">
        <div class="w-full bg-divider h-px animate-fade-in [animation-delay:400ms] [animation-fill-mode:both]"></div>
        <ThemePicker class="animate-fade-in-up [animation-delay:500ms] [animation-fill-mode:both]" />
      </div>
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
