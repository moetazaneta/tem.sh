      here i post some experiments i did for fun. hand-coding.
      traditional-coding.
    </p>

    <div class="flex flex-col items-start gap-4 animate-fade-in-up [animation-delay:300ms] [animation-fill-mode:both]">
      <a
        href="/masturbation/button-morping-into-popup"
        class="color-accent underline underline-offset-4 decoration-1 decoration-accent hover:decoration-accent"
      >
        button morphing into popup
      </a>
    </div>
  </div>
</Layout>
