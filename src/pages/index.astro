---
import ThemePicker from "../components/theme-picker.astro";
import GreenyLayout from "../layouts/greeny-layout.astro";
import Link from "../components/link.astro";

import GithubLogoIcon from "phosphor-astro/GithubLogo.astro";
import TelegramLogoIcon from "phosphor-astro/TelegramLogo.astro";
// import XLogoIcon from "phosphor-astro/AnilistLogo.astro";
import TradingViewLogo from "../assets/logo-tradingview.svg";
import GithubLogo from "../assets/logo-github.svg";
import TelegramLogo from "../assets/logo-telegram.svg";
import LinkedInLogo from "../assets/logo-linkedin.svg";

import "../styles/global.css";
import Pill from "../components/pill.astro";
---

<GreenyLayout>
  <div class="flex flex-col gap-16 font-louize h-full">
    <p>
      yo, im tem. i love programming, design, and my beatuful wife. for me,
      simple base and stylized details makes best user experience.
    </p>

    <p>
      currently a frontend engineer at{" "}
      <Pill href="https://tradingview.com" class="group">
        <TradingViewLogo
          slot="icon"
          class="size-5 squircle-lg group-hover:scale-105 group-hover:-rotate-5 transition"
        />
        tradingview
      </Pill>
      , working on trading panel at chart product. if interested, here is my{" "}
      <Pill href="/cv">cv</Pill>.
    </p>
    <div class="flex flex-col gap-4">
      <p>
        find me on
        <span> </span>
        <a
          href="https://www.linkedin.com/in/moeta/"
          class="ml-0.5 mr-1.5 align-text-bottom"
        >
          <LinkedInLogo class="size-5 inline hover:scale-105 hover:-rotate-5 transition squircle-lg" />
        </a>
        <span> </span>
        <a
          href="https://github.com/moetazaneta/"
          class="mr-1.5 align-text-bottom"
        >
          <GithubLogo class="size-5 inline hover:scale-105 hover:-rotate-5 transition squircle-lg" />
        </a>
        <span> </span>
        <a href="https://t.me/temusuke/" class="align-text-bottom">
          <TelegramLogo class="size-5 inline hover:scale-105 hover:-rotate-5 transition squircle-lg" />
        </a>
        <span> </span>, or mail me at{" "}
        <Pill class="" href="mailto:yo@tem.sh">
          yo@tem.sh
        </Pill>
        .
      </p>
      <div class="flex gap-2"></div>
      <p class="font-ibm"></p>
    </div>
    <div class="flex flex-col gap-8 mt-auto">
      <div class="w-full bg-[#848873]/40 h-px"></div>
      <ThemePicker />
    </div>
  </div>
</GreenyLayout>
